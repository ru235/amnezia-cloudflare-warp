# /etc/warp-telegram.env
# Optional Telegram integration: daily reports, alerts and the control bot.
# Install with `./install.sh --telegram` or create this file manually and
# restart the affected services. chmod 600 is required: the file holds a token.
#
# How to get these values: docs/TELEGRAM.md
TG_TOKEN=123456789:AAExampleTokenReplaceMe
TG_CHAT=123456789
